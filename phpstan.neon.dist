parameters:
    level: max
    paths:
        - src
        - config

    reportUnmatchedIgnoredErrors: true
    type_coverage:
        # Typed class constants need PHP 8.3; the package supports 8.2.
        constant: 0
    ignoreErrors:
        -
            identifier: larastan.noEnvCallsOutsideOfConfig
            path: config/anthropic.php
        # A Livewire component uses it, and the package ships none; its tests run it against stubs of Livewire 3 and 4.
        -
            identifier: trait.unused
            path: src/Livewire/InteractsWithClaudeStreams.php
